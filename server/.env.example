# Environment Mode (dev | test | prod)
ENV=dev

# Logging Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Database Connection (MySQL 8.0.16+ / 8.4 LTS, PyMySQL driver, utf8mb4)
DATABASE_URL=mysql+pymysql://rental_user:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:3306/event_rental?charset=utf8mb4

# Integration Test Database Connection (Used for schema-drift & db tests)
TEST_DATABASE_URL=mysql+pymysql://rental_user:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:3306/event_rental_test?charset=utf8mb4

# Allowed CORS Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Application URL
FRONTEND_URL=http://localhost:5173

# Firebase Authentication
FIREBASE_PROJECT_ID=rent4fraction
GOOGLE_APPLICATION_CREDENTIALS=D:\DBMS project\Rent4Fraction\server\secrets\firebase-service-account.json

# Online Payments (DORMANT - default false for Cash on Delivery marketplace)
PAYMENTS_ONLINE_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloud Storage Bucket (Firebase Storage / Google Cloud Storage)
STORAGE_BUCKET=rent4fraction.firebasestorage.app

# COD Marketplace Governance
COD_ENABLED=true
CURRENCY=INR
GOOGLE_SIGNIN_ENABLED=true
VENDOR_ACCEPTANCE_TIMEOUT_HOURS=24
CUSTOMER_MAX_PENDING_BOOKINGS=3
CUSTOMER_NO_SHOW_THRESHOLD=2
REQUIRE_VERIFIED_EMAIL_FOR_CHECKOUT=true
REQUIRE_VERIFIED_PHONE_FOR_CHECKOUT=true
ENABLE_SCHEDULER=true
