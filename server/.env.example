# Environment Mode (dev | test | prod)
ENV=dev

# Logging Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Database Connection (MySQL 8.0.16+ / 8.4 LTS, PyMySQL driver, utf8mb4)
DATABASE_URL=mysql+pymysql://rental_user:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:3306/event_rental?charset=utf8mb4

# Integration Test Database Connection (Used for schema-drift & db tests)
TEST_DATABASE_URL=mysql+pymysql://rental_user:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:3306/event_rental_test?charset=utf8mb4

# Allowed CORS Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Application URL (for generating email verification and password reset links)
FRONTEND_URL=http://localhost:5173

# Firebase Authentication (Optional in initial foundation; validated when auth is used)
FIREBASE_PROJECT_ID=rent4fraction-dev
GOOGLE_APPLICATION_CREDENTIALS=

# Razorpay Payment Gateway (Optional in initial foundation; validated when payments are used)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloud Storage Bucket (Optional)
STORAGE_BUCKET=

# Checkout Policy Rules
REQUIRE_VERIFIED_EMAIL_FOR_CHECKOUT=true
