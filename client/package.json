{
  "name": "rent4fraction-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "check:slop": "node scripts/check-slop.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:mobile": "node scripts/check-mobile.mjs",
    "check:raw-img": "node scripts/check-raw-img.mjs",
    "check:prod-bundle": "node scripts/check-prod-bundle.mjs",
    "smoke:cloudinary": "python ../server/scripts/smoke_cloudinary.py",
    "test:mobile": "playwright test",
    "preview": "vite preview",
    "check:release": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:prod-bundle",
    "autobug": "playwright test --config=e2e/autobug/playwright.autobug.config.ts",
    "autobug:fast": "playwright test --config=e2e/autobug/playwright.autobug.config.ts --project=chromium --grep=\"Role: VISITOR\"",
    "autobug:staging": "playwright test --config=e2e/autobug/playwright.autobug.config.ts --project=staging"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@hookform/resolvers": "^6.0.1",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@tabler/icons-react": "^3.50.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^13.1.0",
    "lucide-react": "^1.62.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.2.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.0.6",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
