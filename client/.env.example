# Rent4Fraction Client Environment Configuration Template
# Copy to .env.local for local overrides. Never commit sensitive credentials.

# API Base URL (e.g. http://127.0.0.1:8000 for dev, https://rent4fraction-api.onrender.com for prod)
VITE_API_BASE_URL=

# Cloudinary Public Delivery Cloud Name
VITE_CLOUDINARY_CLOUD_NAME=

# Firebase Web App Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local Development & Emulation Flags
VITE_USE_AUTH_EMULATOR=false
VITE_DEV_TOOLS=false
VITE_SHOW_SAMPLE_NOTICE=false

# Support & Contact Information
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
