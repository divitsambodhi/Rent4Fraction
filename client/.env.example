# Rent4Fraction Client Environment Configuration Example
# Copy to .env.local for local development

# API Mode: 'real' (connects to FastAPI backend) or 'mock' (client-only mock data)
VITE_API_MODE=real

# Backend API Base URL (FastAPI server)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Firebase Web App Credentials (from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=AIzaSyATLn4vkDdUB1CMW7hfjcB6mwxL4fHyZGU
VITE_FIREBASE_AUTH_DOMAIN=rent4fraction.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rent4fraction
VITE_FIREBASE_STORAGE_BUCKET=rent4fraction.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=924777925498
VITE_FIREBASE_APP_ID=1:924777925498:web:f4aa21d39a89e52454e4c3

# Firebase Auth Emulator (true to use local auth emulator on localhost:9099)
VITE_USE_AUTH_EMULATOR=false

# Developer Tools & Preview Panels (only active in dev mode when VITE_API_MODE=mock)
VITE_DEV_TOOLS=true

# Optional Site Config Overrides
VITE_SUPPORT_EMAIL=support@rent4fraction.in
VITE_SUPPORT_PHONE=+91 80 4567 8900

