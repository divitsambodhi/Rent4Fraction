# ============================================================
# Event Equipment Rental Platform — Database .env
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── MySQL Credentials ───────────────────────────────────────
# The database name created by manual/00_create_database_and_user.sql
MYSQL_DATABASE=event_rental

# Application user created by manual/00_create_database_and_user.sql
MYSQL_USER=rental_user

# The password you set when running manual/00_create_database_and_user.sql
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Host & Port for your local Windows MySQL server
# Using 127.0.0.1 avoids IPv6 resolution delays on Windows
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ── FastAPI backend reference (copy into /server/.env later) ─
# DATABASE_URL=mysql+pymysql://rental_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:3306/event_rental
