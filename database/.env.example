# ============================================================
# Event Equipment Rental Platform — Database .env
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── MySQL ───────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=event_rental
MYSQL_USER=rental_user
MYSQL_PASSWORD=rental_pass

# Host used by the Python scripts (migrate.py / seed.py / run_checks.py).
# Change to 127.0.0.1 if "localhost" resolves via a socket on your OS.
MYSQL_HOST=localhost

# Host port mapped to the container's 3306.
# Change to 3307 here AND in docker-compose.yml if 3306 is already in use.
MYSQL_PORT=3306

# ── Adminer Web UI ──────────────────────────────────────────
ADMINER_PORT=8080

# ── FastAPI backend (copy into /server/.env) ─────────────────
# DATABASE_URL=mysql+pymysql://rental_user:rental_pass@localhost:3306/event_rental
