erDiagram
    users {
        BIGINT_UNSIGNED user_id PK
        VARCHAR128 firebase_uid UK
        VARCHAR255 name
        VARCHAR255 email UK
        VARCHAR20 phone
        ENUM role
        TINYINT is_active
        TINYINT email_verified
        DATETIME last_login
        DATETIME created_at
        DATETIME updated_at
    }
    vendors {
        BIGINT_UNSIGNED vendor_id PK
        BIGINT_UNSIGNED user_id FK
        VARCHAR255 business_name
        TEXT description
        TEXT address
        VARCHAR20 phone
        VARCHAR500 logo_url
        VARCHAR20 gst_number
        ENUM approval_status
        TEXT rejection_reason
        BIGINT_UNSIGNED approved_by FK
        DATETIME approved_at
        DECIMAL commission_rate
        DATETIME created_at
        DATETIME updated_at
    }
    addresses {
        BIGINT_UNSIGNED address_id PK
        BIGINT_UNSIGNED user_id FK
        VARCHAR100 label
        VARCHAR255 line1
        VARCHAR255 line2
        VARCHAR100 city
        VARCHAR100 state
        VARCHAR20 pincode
        VARCHAR100 country
        TINYINT is_default
        DATETIME created_at
    }
    categories {
        BIGINT_UNSIGNED category_id PK
        VARCHAR100 name
        TEXT description
        BIGINT_UNSIGNED parent_id FK
        TINYINT is_active
    }
    equipment {
        BIGINT_UNSIGNED equipment_id PK
        BIGINT_UNSIGNED vendor_id FK
        BIGINT_UNSIGNED category_id FK
        VARCHAR255 name
        TEXT description
        DECIMAL price_per_day
        DECIMAL security_deposit
        INT quantity
        INT min_rental_days
        TINYINT delivery_available
        JSON specifications
        DECIMAL avg_rating
        INT review_count
        ENUM status
        DATETIME created_at
        DATETIME updated_at
    }
    equipment_images {
        BIGINT_UNSIGNED image_id PK
        BIGINT_UNSIGNED equipment_id FK
        VARCHAR500 url
        TINYINT is_primary
        INT sort_order
    }
    availability {
        BIGINT_UNSIGNED availability_id PK
        BIGINT_UNSIGNED equipment_id FK
        DATE start_date
        DATE end_date
        INT quantity_blocked
        ENUM reason
        ENUM status
    }
    coupons {
        BIGINT_UNSIGNED coupon_id PK
        VARCHAR50 code UK
        ENUM type
        DECIMAL value
        DECIMAL min_order_amount
        DATETIME valid_from
        DATETIME valid_to
        INT usage_limit
        INT used_count
        TINYINT is_active
    }
    bookings {
        BIGINT_UNSIGNED booking_id PK
        BIGINT_UNSIGNED user_id FK
        BIGINT_UNSIGNED address_id FK
        DATETIME booking_date
        DATE start_date
        DATE end_date
        VARCHAR255 event_name
        VARCHAR100 event_type
        DATE event_date
        TEXT venue_address
        DECIMAL subtotal
        DECIMAL discount
        BIGINT_UNSIGNED coupon_id FK
        DECIMAL tax
        DECIMAL delivery_fee
        DECIMAL security_deposit
        DECIMAL total_amount
        ENUM payment_status
        ENUM status
        TEXT notes
        DATETIME created_at
        DATETIME updated_at
    }
    vendor_orders {
        BIGINT_UNSIGNED vendor_order_id PK
        BIGINT_UNSIGNED booking_id FK
        BIGINT_UNSIGNED vendor_id FK
        DECIMAL subtotal
        ENUM status
        TEXT rejection_reason
        DATETIME created_at
        DATETIME updated_at
    }
    booking_items {
        BIGINT_UNSIGNED booking_item_id PK
        BIGINT_UNSIGNED vendor_order_id FK
        BIGINT_UNSIGNED booking_id FK
        BIGINT_UNSIGNED vendor_id FK
        BIGINT_UNSIGNED equipment_id FK
        INT quantity
        DECIMAL price_per_day
        INT days
        DECIMAL total_price
        ENUM item_status
    }
    payments {
        BIGINT_UNSIGNED payment_id PK
        BIGINT_UNSIGNED booking_id FK
        DECIMAL amount
        ENUM type
        ENUM method
        VARCHAR100 gateway
        VARCHAR10 currency
        VARCHAR255 transaction_id UK
        ENUM status
        VARCHAR255 refund_reference
        DATETIME payment_date
        DATETIME created_at
    }
    deliveries {
        BIGINT_UNSIGNED delivery_id PK
        BIGINT_UNSIGNED vendor_order_id FK
        ENUM type
        DATETIME scheduled_start
        DATETIME scheduled_end
        DATETIME delivery_date
        ENUM status
        TEXT tracking_info
        VARCHAR255 delivered_by
        VARCHAR500 proof_url
        DATETIME created_at
        DATETIME updated_at
    }
    returns {
        BIGINT_UNSIGNED return_id PK
        BIGINT_UNSIGNED vendor_order_id FK
        DATE return_date
        ENUM status
        DATETIME created_at
        DATETIME updated_at
    }
    return_items {
        BIGINT_UNSIGNED return_item_id PK
        BIGINT_UNSIGNED return_id FK
        BIGINT_UNSIGNED booking_item_id FK
        INT quantity_returned
        ENUM item_condition
    }
    damage_reports {
        BIGINT_UNSIGNED report_id PK
        BIGINT_UNSIGNED return_item_id FK
        TEXT description
        DECIMAL damage_cost
        TINYINT deducted_from_deposit
        ENUM status
        TEXT images_notes
        BIGINT_UNSIGNED resolved_by FK
        DATETIME created_at
    }
    reviews {
        BIGINT_UNSIGNED review_id PK
        BIGINT_UNSIGNED user_id FK
        BIGINT_UNSIGNED booking_item_id FK
        BIGINT_UNSIGNED equipment_id FK
        BIGINT_UNSIGNED vendor_id FK
        TINYINT rating
        TEXT comment
        TEXT vendor_reply
        DATETIME review_date
    }
    cart_items {
        BIGINT_UNSIGNED cart_item_id PK
        BIGINT_UNSIGNED user_id FK
        BIGINT_UNSIGNED equipment_id FK
        INT quantity
        DATE start_date
        DATE end_date
        DATETIME created_at
        DATETIME updated_at
    }
    wishlist {
        BIGINT_UNSIGNED user_id FK
        BIGINT_UNSIGNED equipment_id FK
        DATETIME created_at
    }
    payouts {
        BIGINT_UNSIGNED payout_id PK
        BIGINT_UNSIGNED vendor_id FK
        BIGINT_UNSIGNED vendor_order_id FK
        DECIMAL gross_amount
        DECIMAL commission_amount
        DECIMAL net_amount
        ENUM status
        DATETIME paid_at
        DATETIME created_at
        DATETIME updated_at
    }
    notifications {
        BIGINT_UNSIGNED notification_id PK
        BIGINT_UNSIGNED user_id FK
        VARCHAR100 type
        VARCHAR255 title
        TEXT message
        TINYINT is_read
        DATETIME created_at
    }
    messages {
        BIGINT_UNSIGNED message_id PK
        BIGINT_UNSIGNED sender_id FK
        BIGINT_UNSIGNED receiver_id FK
        BIGINT_UNSIGNED equipment_id FK
        TEXT body
        TINYINT is_read
        DATETIME created_at
    }

